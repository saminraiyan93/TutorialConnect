@{
    ViewData["Title"] = "Home";
}

<div class="container py-4">

    
    <!-- User Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h4 class="mb-1">
                Welcome, @ViewBag.User 👋
            </h4>
            <p class="text-muted mb-0">
                Find help with your courses or help someone else learn.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Post"
               asp-action="MyPosts"
               class="btn btn-outline-primary">
                My Posts
            </a>

            <a asp-controller="Profile"
               asp-action="Index"
               class="btn btn-outline-secondary">
                My Profile
            </a>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="d-inline">

                <button type="submit"
                        class="btn btn-outline-danger">
                    Logout
                </button>

            </form>

        </div>

    </div>


    <!-- Main Heading -->
    <div class="text-center mb-4">

        <h1 class="fw-bold">
            AIUB TutorConnect
        </h1>

        <p class="text-muted fs-5">
            Connect with fellow AIUB students to learn and teach together.
        </p>

    </div>


    <!-- Main Actions -->
    <div class="row justify-content-center g-4 mb-5">

        <!-- Find a Tutor -->
        <div class="col-md-5">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <div class="mb-3">
                        <span class="fs-1">🎓</span>
                    </div>

                    <h3 class="card-title fw-bold">
                        I Want to Learn
                    </h3>

                    <p class="card-text text-muted mb-4">
                        Find an AIUB student who can help you with a course,
                        assignment, or exam preparation.
                    </p>

                    <a asp-controller="Tutor"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">
                        Find a Tutor
                    </a>

                </div>

            </div>

        </div>


        <!-- Find Students -->
        <div class="col-md-5">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <div class="mb-3">
                        <span class="fs-1">👨‍🏫</span>
                    </div>

                    <h3 class="card-title fw-bold">
                        I Want to Teach
                    </h3>

                    <p class="card-text text-muted mb-4">
                        Find fellow AIUB students who need help with
                        courses that you can teach.
                    </p>

                    <a asp-controller="Student"
                       asp-action="PostStudentRequest"
                       class="btn btn-success btn-lg px-4">
                        Offer to Teach
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- How It Works -->
    <div class="mb-4">

        <div class="text-center mb-4">

            <h2 class="fw-bold">
                How AIUB TutorConnect Works
            </h2>

            <p class="text-muted">
                Learning and teaching becomes easier when AIUB students
                connect with each other.
            </p>

        </div>


        <div class="row g-4">

            <!-- Step 1 -->
            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body text-center p-4">

                        <div class="fs-1 mb-3">
                            🔍
                        </div>

                        <h5 class="fw-bold">
                            1. Find What You Need
                        </h5>

                        <p class="text-muted mb-0">
                            Looking for help? Browse tutor offers and
                            find an AIUB student who can teach the course
                            you need help with.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Step 2 -->
            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body text-center p-4">

                        <div class="fs-1 mb-3">
                            📝
                        </div>

                        <h5 class="fw-bold">
                            2. Post What You Can Offer
                        </h5>

                        <p class="text-muted mb-0">
                            If you can teach a course, create a tutor offer
                            so other students looking for help can find you.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Step 3 -->
            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body text-center p-4">

                        <div class="fs-1 mb-3">
                            🤝
                        </div>

                        <h5 class="fw-bold">
                            3. Connect & Learn
                        </h5>

                        <p class="text-muted mb-0">
                            Find the right match, reach out to each other,
                            and arrange your tutoring session.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</div>
