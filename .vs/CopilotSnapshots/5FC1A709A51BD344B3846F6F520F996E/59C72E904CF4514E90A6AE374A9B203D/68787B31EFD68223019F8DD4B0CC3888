@{
@{
    ViewData["Title"] = "Offer to Teach";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Offer to Teach</h1>
        <p class="text-muted mb-0">
            Share the course or topic you can help other AIUB students with.
        </p>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4 p-md-5">

            <form asp-controller="Student" asp-action="PostStudentRequest" method="post">

                <!-- Tutor Information -->
                <div class="mb-5">

                    <h4 class="fw-bold mb-3">
                        Tutor Information
                    </h4>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Tutor Name
                        </label>

                        <input type="text"
                               value="@ViewBag.UserName"
                               class="form-control"
                               readonly />
                    </div>

                </div>


                <!-- Course Information -->
                <div class="mb-5">

                    <h4 class="fw-bold mb-3">
                        Course & Teaching
                    </h4>

                    <hr />

                    <div class="row g-3">

                        <!-- Course -->
                        <div class="col-md-8">

                            <label for="course"
                                   class="form-label fw-semibold">
                                Course <span class="text-danger">*</span>
                            </label>

                            <select id="course"
                                    name="CourseId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select a Course --
                                </option>

                                @foreach (var item in ViewBag.Courses)
                                {
                                    <option value="@item.CourseId"
                                            data-department="@item.CourseDepartmentName">

                                        @item.CourseName

                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Department -->
                        <div class="col-md-4">

                            <label for="department"
                                   class="form-label fw-semibold">
                                Department
                            </label>

                            <input type="text"
                                   id="department"
                                   placeholder="Selected department"
                                   class="form-control"
                                   readonly />

                        </div>


                        <!-- Coverage -->
                        <div class="col-md-6">

                            <label for="coverage-type"
                                   class="form-label fw-semibold">

                                Coverage <span class="text-danger">*</span>

                            </label>

                            <select id="coverage-type"
                                    name="CoverageType"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Coverage --
                                </option>

                                <option value="Full">
                                    Full Course
                                </option>

                                <option value="Specific">
                                    Specific Topic
                                </option>

                            </select>

                        </div>


                        <!-- Teaching Mode -->
                        <div class="col-md-6">

                            <label for="teaching-mode"
                                   class="form-label fw-semibold">

                                Teaching Mode <span class="text-danger">*</span>

                            </label>

                            <select id="teaching-mode"
                                    name="TeachingMode"
                                    class="form-select"
                                    required>

                                <option value="Online">
                                    Online
                                </option>

                                <option value="Offline">
                                    Offline
                                </option>

                                <option value="Hybrid">
                                    Hybrid (Online & Offline)
                                </option>

                            </select>

                        </div>


                        <!-- Topic Description -->
                        <div class="col-12">

                            <label for="topic-description"
                                   class="form-label fw-semibold">

                                What I Can Help With
                                <span class="text-danger">*</span>

                            </label>

                            <textarea id="topic-description"
                                      name="TopicDescription"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Select a coverage type first..."
                                      readonly
                                      required></textarea>

                            <div class="form-text">
                                If you select <strong>Full Course</strong>,
                                this will automatically be set to "Full Course".
                                For a specific topic, describe what you can teach.
                            </div>

                        </div>


                        <!-- Post Title -->
                        <div class="col-12">

                            <label for="post-title"
                                   class="form-label fw-semibold">

                                Post Title <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   id="post-title"
                                   name="PostTitle"
                                   class="form-control"
                                   placeholder="e.g. I can help you with SOLID and Design Patterns"
                                   required />

                        </div>

                    </div>

                </div>


                <!-- Pricing & Availability -->
                <div class="mb-5">

                    <h4 class="fw-bold mb-3">
                        Pricing & Availability
                    </h4>

                    <hr />

                    <div class="row g-3">

                        <!-- Pricing Type -->
                        <div class="col-md-6">

                            <label for="pricing-type"
                                   class="form-label fw-semibold">

                                Pricing <span class="text-danger">*</span>

                            </label>

                            <select id="pricing-type"
                                    name="PricingType"
                                    class="form-select"
                                    required>

                                <option value="Paid">
                                    Paid
                                </option>

                                <option value="Free">
                                    Free
                                </option>

                            </select>

                        </div>


                        <!-- Rate -->
                        <div class="col-md-6">

                            <label for="rate-amount"
                                   class="form-label fw-semibold">

                                Rate
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    BDT
                                </span>

                                <input type="number"
                                       id="rate-amount"
                                       name="RateAmount"
                                       class="form-control"
                                       placeholder="Amount per lecture"
                                       min="0"
                                       step="1" />

                                <span class="input-group-text">
                                    / lecture
                                </span>

                            </div>

                            <div class="form-text">
                                Rate is not required for free tutoring.
                            </div>

                        </div>


                        <!-- Availability -->
                        <div class="col-12">

                            <label for="availability"
                                   class="form-label fw-semibold">

                                Availability <span class="text-danger">*</span>

                            </label>

                            <textarea id="availability"
                                      name="Availability"
                                      class="form-control"
                                      rows="3"
                                      placeholder="e.g. Saturday and Sunday, 7:00 PM - 10:00 PM"
                                      required></textarea>

                            <div class="form-text">
                                Let students know when you are generally available.
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Contact Information -->
                <div class="mb-5">

                    <h4 class="fw-bold mb-3">
                        Contact Information
                    </h4>

                    <hr />

                    <div class="row g-3">

                        <!-- Contact Method -->
                        <div class="col-md-5">

                            <label for="contact-via"
                                   class="form-label fw-semibold">

                                Contact Method <span class="text-danger">*</span>

                            </label>

                            <select id="contact-via"
                                    name="ContactVia"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Contact Method --
                                </option>

                                <option value="Microsoft Teams">
                                    Microsoft Teams
                                </option>

                                <option value="Facebook">
                                    Facebook
                                </option>

                                <option value="WhatsApp">
                                    WhatsApp
                                </option>

                                <option value="Phone">
                                    Phone
                                </option>

                                <option value="Others">
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Contact Information -->
                        <div class="col-md-7">

                            <label for="contact-information"
                                   class="form-label fw-semibold">

                                Contact Information
                                <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   id="contact-information"
                                   name="ContactValue"
                                   class="form-control"
                                   placeholder="Select a contact method first"
                                   required />

                            <div id="contact-help"
                                 class="form-text">
                                Choose how students can contact you.
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 pt-2">

                    <a asp-controller="Tutor"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Create Post
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        var course = document.getElementById("course");
        var department = document.getElementById("department");

        var coverageType = document.getElementById("coverage-type");
        var topicDescription = document.getElementById("topic-description");

        var pricingType = document.getElementById("pricing-type");
        var rateAmount = document.getElementById("rate-amount");

        var contactVia = document.getElementById("contact-via");
        var contactInformation = document.getElementById("contact-information");
        var contactHelp = document.getElementById("contact-help");


        /*
         * Course -> Department
         */
        course.addEventListener("change", function () {

            var selectedOption =
                this.options[this.selectedIndex];

            department.value =
                selectedOption.getAttribute("data-department") || "";

        });


        /*
         * Coverage Type -> Topic Description
         */
        coverageType.addEventListener("change", function () {

            if (this.value === "Full") {

                topicDescription.value = "Full Course";
                topicDescription.readOnly = true;

            }
            else if (this.value === "Specific") {

                topicDescription.value = "";
                topicDescription.readOnly = false;
                topicDescription.placeholder =
                    "e.g. SOLID principles, design patterns, dependency injection...";
                topicDescription.focus();

            }
            else {

                topicDescription.value = "";
                topicDescription.readOnly = true;
                topicDescription.placeholder =
                    "Select a coverage type first...";

            }

        });


        /*
         * Pricing Type -> Rate
         */
        pricingType.addEventListener("change", function () {

            var isFree = this.value === "Free";

            if (isFree) {

                rateAmount.value = 0;
                rateAmount.disabled = true;

            }
            else {

                rateAmount.value = "";
                rateAmount.disabled = false;

            }

        });


        /*
         * Contact Method -> Contact Information
         */
        contactVia.addEventListener("change", function () {

            switch (this.value) {

                case "Microsoft Teams":

                    contactInformation.placeholder =
                        "e.g. 2x-xxxxx-x";

                    contactHelp.textContent =
                        "Enter your Microsoft Teams ID.";

                    break;


                case "Facebook":

                    contactInformation.placeholder =
                        "e.g. https://facebook.com/yourprofile";

                    contactHelp.textContent =
                        "Enter your Facebook profile link.";

                    break;


                case "WhatsApp":

                    contactInformation.placeholder =
                        "e.g. 01712345678";

                    contactHelp.textContent =
                        "Enter the WhatsApp number students can use to contact you.";

                    break;


                case "Phone":

                    contactInformation.placeholder =
                        "e.g. 01712345678";

                    contactHelp.textContent =
                        "Enter the phone number students can use to contact you.";

                    break;


                case "Others":

                    contactInformation.placeholder =
                        "Enter your contact information";

                    contactHelp.textContent =
                        "Provide the contact information for your preferred platform.";

                    break;


                default:

                    contactInformation.placeholder =
                        "Select a contact method first";

                    contactHelp.textContent =
                        "Choose how students can contact you.";

                    break;
            }

        });


        /*
         * Trigger initial states
         */
        course.dispatchEvent(new Event("change"));
        pricingType.dispatchEvent(new Event("change"));

    });

</script>