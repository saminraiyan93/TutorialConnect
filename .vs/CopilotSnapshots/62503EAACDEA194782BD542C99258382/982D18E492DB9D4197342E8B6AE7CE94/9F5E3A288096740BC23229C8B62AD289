@{
}

<script>
    document.getElementById("course").addEventListener("change", function () {

        var selectedOption = this.options[this.selectedIndex];

        var department = selectedOption.getAttribute("data-department");

        document.getElementById("department").value = department || "";
    });
</script>

<script>
    document.getElementById("coverage-type").addEventListener("change", function () {

        var topicDescription = document.getElementById("topic-description");

        if (this.value === "Full") {
            topicDescription.value = "Full Course";
            topicDescription.readOnly = true;
        }
        else if (this.value === "Specific") {
            topicDescription.value = "";
            topicDescription.readOnly = false;
            topicDescription.focus();
        }
        else {
            topicDescription.value = "";
            topicDescription.readOnly = true;
        }

    });
</script>


<script>
    document.getElementById("pricing-type").addEventListener("change", function () {

        var rateAmount = document.getElementById("rate-amount");

        if (this.value === "Paid") {
            rateAmount.value = "";
            rateAmount.readOnly = false;
        }
        else if (this.value === "Free") {
            rateAmount.value = 0;
            rateAmount.readOnly = true;
        }

    });
</script>

<h1>Offer a Course or Topic that you can teach</h1>
<br />

<div class="to-card">
    <form action="" method="post">

        <input type="hidden" value="" name="UserId" placeholder="UserId" class="form-control" />


        <label>Tutor Name: </label>
        <input type="text" value="@ViewBag.UserName" class="form-control" readonly/>


        <label>Select Course: </label>
        <select name="CourseId">
            <option value="">-- Select a Course --</option>
            @foreach (var item in ViewBag.Courses)
            {
                <option value="@item.CourseId" data-department="@item.CourseDepartmentName">@item.CourseName</option>
            }
        </select>
        
        <label>Course Department: </label>
        <input type="Text" id ="department" placeholder="Selected Course Department" class="form-control" readonly />


        <label for="coverage-type">Coverage Type: </label>
        <select id="coverage-type" name="CoverageType">
            <option value="">-- Select Course Coverage --</option>
            <option value="Full">Full Course</option>
            <option value="Specific">Specific Topic from Course</option>
        </select>

        <br />

        <label>Topic Description: </label>
        <input type="text"
               id="topic-description"
               name="TopicDescription"
               placeholder="Enter Specific Topics From Selected Course you can teach"
               class="form-control"
               readonly 
         />
        
        
        <label>Post Title: </label>
        <input type="text" value="" name="PostTitle" placeholder="Let people know what you can teach" class="form-control" />
        
        <label>Teaching Mode: </label>
        <select name="TeachingMode">
            <option>Online</option>
            <option>Offline</option>
            <option>Hybrid (Online & Offline)</option>
        </select>
        <br />

        <label>Pricing Type: </label>
        <select id="pricing-type" name="PricingType">
            <option value="Paid">Paid</option>
            <option value="Free">Free</option>
        </select>

        <br />

        <label>Rate Amount: </label>
        <input type="number"
               id="rate-amount"
               name="RateAmount"
               placeholder="Enter your Price (BDT/Lecture)"
               class="form-control"
               min="0" />

        <label>Availability: </label>
        <input type="text" name="Availability" value="" placeholder="Enter Detailed schedule to let other know when you're free" class="form-control" />
        <label>Contact Via: </label>
        <select name="ContactVia">
            <option>Microsoft Teams</option>
            <option>Facebook</option>
            <option>Whatsapp</option>
            <option>Contact No.</option>
            <option>Others</option>
        </select>
        <br />
        <label>Contact Link: </label>
        <input type="text" name="ContactValue" value="" placeholder="Enter Teams ID, Whatsapp number, Facebook profile link, Contact Number or other" class="form-control" />
        <input type="submit" value="Create Post" />


    </form>
    
</div>
