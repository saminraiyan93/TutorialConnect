@{
    ViewData["Title"] = "Find a Tutor";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Find a Tutor</h1>
        <p class="text-muted mb-0">Share the course or topic you need help with.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <form asp-action="PostTutoringRequest" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-5">
                    <h4 class="fw-bold mb-3">Student Information</h4>
                    <hr />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Student Name</label>
                        <input type="text" value="@ViewBag.UserName" class="form-control" readonly />
                    </div>
                </div>

                <div class="mb-5">
                    <h4 class="fw-bold mb-3">Course & Tutoring</h4>
                    <hr />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="course" class="form-label fw-semibold">Course <span class="text-danger">*</span></label>
                            <select id="course" name="CourseId" class="form-select" required>
                                <option value="">-- Select a Course --</option>
                                @foreach (var item in ViewBag.Courses)
                                {
                                    <option value="@item.CourseId" data-department="@item.CourseDepartmentName">@item.CourseName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="department" class="form-label fw-semibold">Department</label>
                            <input type="text" id="department" placeholder="Selected department" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label for="coverage-type" class="form-label fw-semibold">Coverage <span class="text-danger">*</span></label>
                            <select id="coverage-type" name="CoverageType" class="form-select" required>
                                <option value="">-- Select Coverage --</option>
                                <option value="Full">Full Course</option>
                                <option value="Specific">Specific Topic</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="teaching-mode" class="form-label fw-semibold">Teaching Mode <span class="text-danger">*</span></label>
                            <select id="teaching-mode" name="TeachingMode" class="form-select" required>
                                <option value="Online">Online</option>
                                <option value="Offline">Offline</option>
                                <option value="Hybrid">Hybrid (Online & Offline)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label for="topic-description" class="form-label fw-semibold">What I Need Help With <span class="text-danger">*</span></label>
                            <textarea id="topic-description" name="TopicDescription" class="form-control" rows="3" placeholder="Select a coverage type first..." readonly required></textarea>
                            <div class="form-text">If you select <strong>Full Course</strong>, this will automatically be set to "Full Course". For a specific topic, describe what you need help with.</div>
                        </div>
                        <div class="col-12">
                            <label for="post-title" class="form-label fw-semibold">Post Title <span class="text-danger">*</span></label>
                            <input type="text" id="post-title" name="PostTitle" class="form-control" placeholder="e.g. Looking for help with SOLID and Design Patterns" required />
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h4 class="fw-bold mb-3">Budget & Availability</h4>
                    <hr />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="budget-type" class="form-label fw-semibold">Budget <span class="text-danger">*</span></label>
                            <select id="budget-type" name="BudgetType" class="form-select" required>
                                <option value="Paid">Paid</option>
                                <option value="Free">Free</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="budget-per-lecture" class="form-label fw-semibold">Budget Per Lecture</label>
                            <div class="input-group">
                                <span class="input-group-text">BDT</span>
                                <input type="number" id="budget-per-lecture" name="BudgetPerLecture" class="form-control" placeholder="Amount per lecture" min="0" step="1" />
                                <span class="input-group-text">/ lecture</span>
                            </div>
                            <div class="form-text">Budget is not required for free tutoring.</div>
                        </div>
                        <div class="col-12">
                            <label for="availability" class="form-label fw-semibold">Availability <span class="text-danger">*</span></label>
                            <textarea id="availability" name="Availability" class="form-control" rows="3" placeholder="e.g. Saturday and Sunday, 7:00 PM - 10:00 PM" required></textarea>
                            <div class="form-text">Let tutors know when you are generally available.</div>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h4 class="fw-bold mb-3">Contact Information</h4>
                    <hr />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="connect-via" class="form-label fw-semibold">Contact Method <span class="text-danger">*</span></label>
                            <select id="connect-via" name="ConnectVia" class="form-select" required>
                                <option value="">-- Select Contact Method --</option>
                                <option value="Microsoft Teams">Microsoft Teams</option>
                                <option value="Facebook">Facebook</option>
                                <option value="WhatsApp">WhatsApp</option>
                                <option value="Phone">Phone</option>
                                <option value="Others">Other</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label for="connect-value" class="form-label fw-semibold">Contact Information <span class="text-danger">*</span></label>
                            <input type="text" id="connect-value" name="ConnectValue" class="form-control" placeholder="Select a contact method first" required />
                            <div id="contact-help" class="form-text">Choose how tutors can contact you.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Create Post</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var course = document.getElementById("course");
        var department = document.getElementById("department");
        var coverageType = document.getElementById("coverage-type");
        var topicDescription = document.getElementById("topic-description");
        var budgetType = document.getElementById("budget-type");
        var budgetPerLecture = document.getElementById("budget-per-lecture");
        var connectVia = document.getElementById("connect-via");
        var connectValue = document.getElementById("connect-value");
        var contactHelp = document.getElementById("contact-help");

        course.addEventListener("change", function () {
            var selectedOption = this.options[this.selectedIndex];
            department.value = selectedOption.getAttribute("data-department") || "";
        });

        coverageType.addEventListener("change", function () {
            if (this.value === "Full") {
                topicDescription.value = "Full Course";
                topicDescription.readOnly = true;
            }
            else if (this.value === "Specific") {
                topicDescription.value = "";
                topicDescription.readOnly = false;
                topicDescription.placeholder = "e.g. SOLID principles, design patterns, dependency injection...";
                topicDescription.focus();
            }
            else {
                topicDescription.value = "";
                topicDescription.readOnly = true;
                topicDescription.placeholder = "Select a coverage type first...";
            }
        });

        budgetType.addEventListener("change", function () {
            var isFree = this.value === "Free";
            if (isFree) {
                budgetPerLecture.value = 0;
                budgetPerLecture.disabled = true;
            }
            else {
                budgetPerLecture.value = "";
                budgetPerLecture.disabled = false;
            }
        });

        connectVia.addEventListener("change", function () {
            switch (this.value) {
                case "Microsoft Teams":
                    connectValue.placeholder = "e.g. 2x-xxxxx-x";
                    contactHelp.textContent = "Enter your Microsoft Teams ID.";
                    break;
                case "Facebook":
                    connectValue.placeholder = "e.g. https://facebook.com/yourprofile";
                    contactHelp.textContent = "Enter your Facebook profile link.";
                    break;
                case "WhatsApp":
                case "Phone":
                    connectValue.placeholder = "e.g. 01712345678";
                    contactHelp.textContent = "Enter the number tutors can use to contact you.";
                    break;
                case "Others":
                    connectValue.placeholder = "Enter your contact information";
                    contactHelp.textContent = "Provide the contact information for your preferred platform.";
                    break;
                default:
                    connectValue.placeholder = "Select a contact method first";
                    contactHelp.textContent = "Choose how tutors can contact you.";
                    break;
            }
        });

        course.dispatchEvent(new Event("change"));
        budgetType.dispatchEvent(new Event("change"));
    });
</script>