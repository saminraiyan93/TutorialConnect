    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>Find a Tutor</h1>

        <p class="text-muted">
            Browse students who are offering tutoring for AIUB courses.
        </p>
    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            if (item.PostStatus == "Active")
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <h4 class="card-title">
                                @item.PostTitle
                            </h4>

                            <p class="text-muted mb-2">
                                Tutor: @item.UserName
                            </p>

                            <p>
                                <strong>Course:</strong>
                                @item.CourseName
                            </p>

                            <p>
                                <strong>Department:</strong>
                                @item.DepartmentName
                            </p>

                            <p>
                                <strong>Coverage:</strong>
                                @item.CoverageType
                            </p>

                            @if (item.CoverageType == "Selected")
                            {
                                <p>
                                    <strong>Topics:</strong>
                                    @item.TopicDescription
                                </p>
                            }

                            <p>
                                <strong>Teaching Mode:</strong>
                                @item.TeachingMode
                            </p>

                            <p>
                                <strong>Pricing:</strong>
                                @item.PricingType
                            </p>

                            @if (item.PricingType == "Paid")
                            {
                                <p>
                                    <strong>Rate:</strong>
                                    @item.RateAmount BDT per lecture
                                </p>
                            }

                            <p>
                                <strong>Availability:</strong>
                                @item.Availability
                            </p>

                            <p class="text-muted">
                                Posted on:
                                @item.CreatedAt.ToString("dd MMM yyyy")
                            </p>

                        </div>

                        <div class="card-footer bg-white">

                            <a class="btn btn-primary w-100"
                               asp-controller="TutorOffering"
                               asp-action="Details"
                               asp-route-id="@item.TutorOfferingId">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>




