@{
}

@Html.ValidationSummary()

<form action="" method="post">
    <input type="text" name="Email" value="@Model.Email" placeholder="Enter Email" class="form-control" />
    <span class="text-danger">@Html.ValidationMessage("Email")</span>

    <input type="password" name="Password" placeholder="Enter Password" class="form-control" />
    <span class="text-danger">@Html.ValidationMessage("Password")</span>

    <input type="submit" value="Login" class="btn btn-primary" />

</form>

<a href="/account/registration"> Create a new account</a>
